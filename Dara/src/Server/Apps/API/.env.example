# copy to .env next to this file (git-ignored), it is copied to the output directory and loaded at startup;
# names follow .net configuration, Seed__Enabled is the same as Seed:Enabled in appsettings.json

# signing key of the access tokens (HS256), required, at least 32 bytes; generate one, for example in PowerShell:
# [Convert]::ToBase64String([Security.Cryptography.RandomNumberGenerator]::GetBytes(48))
Jwt__SigningKey=
# lifetime of a device access token, the client refreshes it over /auth/refresh
Jwt__AccessTokenLifetime=00:15:00
# attempts of /auth/device-login per client address and minute
Auth__DeviceLoginPermitsPerMinute=10

# seed sample users, profiles and groups at startup
Seed__Enabled=true
# how long a seeder waits until other modules got its events
Seed__WaitTimeout=00:00:10
# password of every seeded account (login user-1 ... user-5), required when the seed is on, 8 to 128 characters
Seed__UserPassword=

# agent settings the owner of every seeded group gets, the key stays in this file and in memory only
Seed__AgentProvider=google
Seed__AgentModel=gemini-3.1-flash-lite
Seed__AgentApiKey=
